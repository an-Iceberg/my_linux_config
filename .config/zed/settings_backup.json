// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "colorize_brackets": true,
  "window_decorations": "server",
  "tab_bar": {
    "show": true,
  },
  "active_pane_modifiers": {
    "border_size": 1,
    "inactive_opacity": 0.8,
  },
  "auto_indent": "syntax_aware",
  "auto_install_extensions": {
    "andromeda": true,
    "cargo-tom": true,
    "catppuccin-icons": true,
    "codebook": true,
    "color-highlight": true,
    "comment": true,
    "csv": true,
    "deno": true,
    "discord-presence": true,
    "docker-compose": false,
    "dockerfile": true,
    "elm": true,
    "env": true,
    "git-firefly": true,
    "haskell": true,
    "html": true,
    "ini": true,
    "java": true,
    "julia": true,
    "just": true,
    "log": true,
    "luau": true,
    "make": true,
    "nix": true,
    "nu": true,
    "postgres-langauge-server": true,
    "pytest-language-server": true,
    "python-requirements": true,
    "python-snippets": true,
    "qml": true,
    "rainbow-csv": true,
    "ruff": true,
    "rust-and-brown": true,
    "rust-snippets": true,
    "shades-of-purple-theme": true,
    "slint": true,
    "sql": true,
    "svelte": true,
    "svelte-snippets": true,
    "tera": true,
    "toml": true,
    "typescript-snippets": true,
    "typst": true,
    "xml": true,
  },
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": true,
  "auto_signature_help": true,
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_size": 12,
  "buffer_font_family": "IosevkaTermSlab Nerd Font Mono",
  "confirm_quit": true,
  "disable_ai": true,
  "extend_comment_on_newline": false,
  "hide_mouse": "on_typing",
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "always",
    "show_diagnostics": "all",
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_sign_in": true,
    "show_menus": false,
    "show": "always",
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "code_actions": true,
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    // "qml": {
    //   "binary": {
    //     "arguments": ["-E", "additional-args"],
    //   },
    // },
    // "tinymist": {
    //   "settings": {
    //     "exportPdf": "onSave",
    //     "outputPath": "$root/$name",
    //   },
    // },
  },
  "tab_size": 2,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "icon_theme": "Catppuccin Frappé",
  "ui_font_size": 15,
  "minimap": {
    "show": "never",
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "global_lsp_settings": {
    "button": true,
  },
  "cursor_blink": true,
  "selection_highlight": true,
  "current_line_highlight": "all",
  "preferred_line_length": 9999,
  "soft_wrap": "none",
  "show_wrap_guides": false,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Synthwave84",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "hover_popover_enabled": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
    "branch_picker": {
      "show_author_name": true,
    },
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 2,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "languages": {
    "Python": {
      "tab_size": 4,
    },
    "Rust": {
      "format_on_save": "off",
    },
    "TypeScript": {
      "language_servers": ["deno"],
      "formatter": "language_server",
    },
    "Make": {
      "tab_size": 4,
      "hard_tabs": true,
    },
    "QML": {
      // "enable_language_server": true,
      "format_on_save": "off",
      // "language_servers": ["qmllls6", "qmllint"],
      // "formatter": {
      //   "external": {
      //     "command": "qmlformat",
      //     "arguments": ["{buffer_path}"],
      //   },
      // },
    },
    "Slint": {
      "format_on_save": "off",
    },
    "Just": {
      "format_on_save": "off",
    },
    "Kotlin": {
      "format_on_save": "on",
      "tab_size": 4,
    },
    "Elm": {
      "format_on_save": "off",
    },
  },
  "line_indicator_format": "long",
  "linked_edits": true,
  "profiles": {
    "presentation": {
      "settings": {
        "buffer_font_size": 20,
        "ui_font_size": 18,
        "theme": "Catppuccin Latte (Blur)",
      },
    },
  },
  "tasks": {
    "enabled": true,
  },
  "terminal": {
    "dock": "right",
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
      },
    },
    "toolbar": {
      "breadcrumbs": false,
    },
    "button": true,
  },
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard",
    "scrollbar": {
      "show": "auto",
    },
    "hide_root": true,
  },
  "debugger": {
    "dock": "right",
  },
  "show_completions_on_input": true,
}
