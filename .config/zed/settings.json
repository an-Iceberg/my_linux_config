// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "active_pane_modifiers": {
    "border_size": 1,
    "inactive_opacity": 0.8
  },
  "auto_indent": true,
  "auto_install_extensions": {
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "csv": true,
    "codebook": true,
    "deno": true,
    "discord-presence": true,
    "docker-compose": false,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "html": true,
    "java": true,
    "julia": true,
    "log": true,
    "nix": true,
    "nu": true,
    "postgres-langauge-server": true,
    "python-requirements": true,
    "rainbow-csv": true,
    "ruff": true,
    "rust-snippets": true,
    "sql": true,
    "svelte": true,
    "tera": true,
    "toml": true,
    "xml": true
  },
  "autosave": "on_focus_change",
  "autoscroll_on_clicks": true,
  "auto_signature_help": true,
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_size": 12,
  "buffer_font_family": "IosevkaTermSlab Nerd Font Mono",
  "confirm_quit": true,
  "disable_ai": true,
  "extend_comment_on_newline": false,
  "hide_mouse": "on_typing",
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "always",
    "show_diagnostics": "all"
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_sign_in": true,
    "show_menus": false,
    "show": "always"
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "code_actions": true
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "tab_size": 2,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "icon_theme": "Catppuccin Frappé",
  "ui_font_size": 15,
  "minimap": { "show": "never" },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true
  },
  "global_lsp_settings": {
    "button": true
  },
  "cursor_blink": true,
  "selection_highlight": true,
  "current_line_highlight": "all",
  "preferred_line_length": 100,
  "soft_wrap": "preferred_line_length",
  "show_wrap_guides": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Frappé (Blur) [Light]"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "hover_popover_enabled": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    },
    "branch_picker": {
      "show_author_name": true
    }
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 2,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware"
  },
  "languages": {
    "Python": {
      "tab_size": 4
    },
    "Rust": {
      "format_on_save": "off"
    }
  },
  "line_indicator_format": "long",
  "linked_edits": true,
  "profiles": {
    "presentation": {
      "buffer_font_size": 20,
      "ui_font_size": 18,
      "theme": "Catppuccin Latte (Blur)"
    }
  },
  "tasks": {
    "enabled": true
  },
  "terminal": {
    "dock": "right",
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"]
      }
    },
    "toolbar": {
      "breadcrumbs": false
    },
    "button": true
  },
  "project_panel": {
    "entry_spacing": "standard",
    "scrollbar": {
      "show": "auto"
    },
    "hide_root": true
  },
  "debugger": {
    "dock": "right"
  },
  "show_completions_on_input": true
}
